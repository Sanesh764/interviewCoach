# Server Configuration
PORT=5000
NODE_ENV=development
# Allowed CORS origins: single URL or comma-separated list of URLs (e.g. http://localhost:5173,https://your-frontend.vercel.app)
CLIENT_URL=http://localhost:5173
FRONTEND_URL=

# Database Connection (MongoDB Atlas in production or local MongoDB for dev)
MONGODB_URI=mongodb://127.0.0.1:27017/interviewcoach

# Authentication
JWT_SECRET=supersecretjwtkey_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# AWS Cloud Configuration (ap-south-1 Mumbai)
AWS_REGION=ap-south-1

# Note on AWS Credentials:
# - On AWS Elastic Beanstalk with an IAM Instance Profile / EC2 role, AWS_ACCESS_KEY_ID & AWS_SECRET_ACCESS_KEY
#   are NOT required (AWS SDK v3 resolves credentials automatically via the default credential chain).
# - For local development, specify your IAM user keys below:
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SESSION_TOKEN=

# Amazon Bedrock Multi-Model Configuration (ap-south-1)
# Primary: Claude 3 Haiku | Fallback 1: Nova Lite | Fallback 2: Gemma 3 27B
BEDROCK_PRIMARY_MODEL=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_FALLBACK_MODEL_1=amazon.nova-lite-v1:0
BEDROCK_FALLBACK_MODEL_2=google.gemma-3-27b-it
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Amazon S3 (Private Bucket)
S3_BUCKET_NAME=interviewcoach-recordings-and-resumes

# Amazon Transcribe
TRANSCRIBE_LANGUAGE_CODE=en-US

# Amazon Polly
POLLY_VOICE_ID=Joanna
POLLY_ENGINE=neural

# Optional Custom DNS Servers (comma-separated, e.g. 1.1.1.1,8.8.8.8) - defaults to AWS VPC DNS in production
CUSTOM_DNS_SERVERS=
