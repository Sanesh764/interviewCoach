# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/interviewcoach

# Authentication
JWT_SECRET=supersecretjwtkey_change_in_production
JWT_EXPIRES_IN=7d

# AWS Configuration (Required for AI & Voice services)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SESSION_TOKEN=optional_session_token_if_using_temporary_credentials

# Amazon Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Amazon S3
S3_BUCKET_NAME=interviewcoach-recordings-and-resumes

# Amazon Transcribe
TRANSCRIBE_LANGUAGE_CODE=en-US

# Amazon Polly
POLLY_VOICE_ID=Joanna
POLLY_ENGINE=neural
